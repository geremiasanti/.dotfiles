# ignore all
*

# unignore files for repo
!.gitignore
!README.md

# unignore configuration files
!.bashrc
!.gitconfig
!.tmux.conf
!.config/
!.config/nvim/
!.config/nvim/**
!.config/alacritty/
!.config/alacritty/alacritty.toml
!.config/alacritty/themes/
!.config/alacritty/themes/themes/
!.config/alacritty/themes/themes/github_dark.toml
!.config/i3/
!.config/i3/**
!.config/custom/
!.config/custom/**
.config/custom/local.sh
!.config/picom/
!.config/picom/**
!.config/assets/
!.config/assets/**

# unignore only Codex global instructions
!.codex/
.codex/*
!.codex/AGENTS.md
